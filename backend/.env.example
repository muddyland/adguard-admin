# ---- Core ----
APP_NAME=AdGuard Admin
DATABASE_URL=sqlite:///./adguard_admin.db

# ---- Security (REQUIRED — the app refuses to start without these) ----
# Long random string for signing JWTs and sessions (minimum 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key to encrypt AdGuard server passwords at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Downgrades the startup configuration checks from fatal to warnings.
# LOCAL DEVELOPMENT ONLY — never set this in a deployment.
ALLOW_INSECURE_CONFIG=false

# ---- Bootstrap admin (created only on first run) ----
# ADMIN_PASSWORD must not be left as "admin"; startup rejects it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Login brute-force protection ----
# Failed logins are counted per client IP and per username.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300

# ---- Reconciliation ----
SYNC_INTERVAL_SECONDS=60
# How many servers to reconcile at once. Raise this if a cycle can't finish
# within SYNC_INTERVAL_SECONDS; each unreachable server costs a full timeout.
SYNC_MAX_CONCURRENCY=8
ADGUARD_TIMEOUT_SECONDS=10

# Database connection pool. Reconciliation never holds a connection while
# talking to an AdGuard server, so these only need raising under API load.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10

DEFAULT_PRUNE=false

# ---- Automatic AdGuard Home updates ----
# Keeps the managed AdGuard installations themselves up to date. A server is only
# upgraded when its own auto-update flag is set AND this is true. Upgrading
# restarts AdGuard Home, so DNS on that server stops for a few seconds.
AUTO_UPDATE_ENABLED=true
# Value the auto-update flag takes for newly added / provisioned servers.
AUTO_UPDATE_DEFAULT=false
AUTO_UPDATE_INTERVAL_SECONDS=3600
# Maintenance window, HH:MM-HH:MM in UTC. Empty = any time. May wrap midnight.
AUTO_UPDATE_WINDOW=
AUTO_UPDATE_RETRY_HOURS=6
AUTO_UPDATE_RESTART_TIMEOUT_SECONDS=300
# One at a time, so the whole fleet never restarts at the same moment.
AUTO_UPDATE_MAX_CONCURRENCY=1

# ---- Embedded AdGuard UI proxy ----
# Serves a managed server's own UI through this app so it can be embedded.
# AdGuard's UI requires localStorage and document.cookie, so it cannot be
# sandboxed into an opaque origin: the proxied instance runs in this app's
# origin and could read your admin session token. Set this to false if you do
# not trust every managed server ("Open UI in new tab" still works).
UI_PROXY_ENABLED=true
PROXY_TOKEN_TTL_MINUTES=60

# ---- Provisioning ----
# Public URL of THIS admin app, reachable by the servers you provision.
# The one-line install command and the script's callbacks use this.
# Using an https:// URL here also switches cookies to Secure and enables HSTS.
PUBLIC_BASE_URL=http://localhost:8000
PROVISION_TOKEN_TTL_HOURS=24

# ---- Frontend / CORS ----
# CORS_ORIGINS must list exact origins; "*" is rejected at startup because
# credentialed requests are enabled.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- OIDC single sign-on (optional) ----
# Provider-agnostic: everything past the issuer and the client credentials comes
# from the provider's discovery document. Tested with Kanidm and Authentik.
OIDC_ENABLED=false
# Kanidm:    https://idm.example.com/oauth2/openid/adguard-admin
# Authentik: https://authentik.example.com/application/o/adguard-admin/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Name of your IdP on the login button: "Sign in with Kanidm".
OIDC_DISPLAY_NAME=SSO
# Kanidm only emits the groups claim when the `groups` scope is requested;
# Authentik folds groups into `profile`. Add `groups` if you use
# OIDC_ADMIN_GROUP and your provider needs it.
OIDC_SCOPES=openid email profile
# Send a PKCE (S256) challenge. Kanidm rejects the authorization request
# without one; harmless elsewhere, so leave this on unless a provider chokes.
OIDC_PKCE=true
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
OIDC_DEFAULT_ROLE=viewer
# Members become admins. Kanidm names groups by SPN
# ("adguard-admins@idm.example.com"); either that or the bare name works.
OIDC_ADMIN_GROUP=adguard-admins
# Allow an OIDC identity to adopt a pre-existing local account whose username
# matches. Off by default: if your IdP lets users pick their own
# preferred_username, enabling this lets them claim someone else's account.
# Even when enabled, accounts that have a local password are never adopted.
OIDC_ALLOW_USERNAME_LINKING=false
