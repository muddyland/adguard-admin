# ---- Core ----
APP_NAME=AdGuard Admin
DATABASE_URL=sqlite:///./adguard_admin.db

# ---- Security (REQUIRED — the app refuses to start without these) ----
# Long random string for signing JWTs and sessions (minimum 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key to encrypt AdGuard server passwords at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Downgrades the startup configuration checks from fatal to warnings.
# LOCAL DEVELOPMENT ONLY — never set this in a deployment.
ALLOW_INSECURE_CONFIG=false

# ---- Bootstrap admin (created only on first run) ----
# ADMIN_PASSWORD must not be left as "admin"; startup rejects it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Login brute-force protection ----
# Failed logins are counted per client IP and per username.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300

# ---- Reconciliation ----
SYNC_INTERVAL_SECONDS=60
# How many servers to reconcile at once. Raise this if a cycle can't finish
# within SYNC_INTERVAL_SECONDS; each unreachable server costs a full timeout.
SYNC_MAX_CONCURRENCY=8
ADGUARD_TIMEOUT_SECONDS=10
DEFAULT_PRUNE=false

# ---- Embedded AdGuard UI proxy ----
# Serves a managed server's own UI through this app so it can be embedded.
# The iframe is sandboxed without allow-same-origin, so the proxied instance
# runs in an opaque origin and cannot read this app's session token.
UI_PROXY_ENABLED=true
PROXY_TOKEN_TTL_MINUTES=60
# Escape hatch for AdGuard builds that refuse to run sandboxed. Setting this
# grants every managed server same-origin access to this app — it can then read
# your admin token. Startup refuses to run with it on unless
# ALLOW_INSECURE_CONFIG=true.
UI_PROXY_ALLOW_SAME_ORIGIN=false

# ---- Provisioning ----
# Public URL of THIS admin app, reachable by the servers you provision.
# The one-line install command and the script's callbacks use this.
# Using an https:// URL here also switches cookies to Secure and enables HSTS.
PUBLIC_BASE_URL=http://localhost:8000
PROVISION_TOKEN_TTL_HOURS=24

# ---- Frontend / CORS ----
# CORS_ORIGINS must list exact origins; "*" is rejected at startup because
# credentialed requests are enabled.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- OIDC / Authentik (optional) ----
OIDC_ENABLED=false
OIDC_ISSUER=https://authentik.example.com/application/o/adguard-admin/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
OIDC_DEFAULT_ROLE=viewer
OIDC_ADMIN_GROUP=adguard-admins
# Allow an OIDC identity to adopt a pre-existing local account whose username
# matches. Off by default: if your IdP lets users pick their own
# preferred_username, enabling this lets them claim someone else's account.
# Even when enabled, accounts that have a local password are never adopted.
OIDC_ALLOW_USERNAME_LINKING=false
